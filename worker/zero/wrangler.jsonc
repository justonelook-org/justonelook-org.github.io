{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "look-at-yourself-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://justonelook.org,https://www.justonelook.org,https://website-test-zero.pages.dev,http://localhost:8000,http://127.0.0.1:8000",
    "OUTCOME_MODEL": "gpt-5.6-luna",
    "OUTCOME_MEASUREMENT_ENABLED": "true",
    "OUTCOME_TEST_ORIGIN": "https://website-test-zero.pages.dev",
    "TRAFFIC_MEASUREMENT_ENABLED": "true",
    "TRAFFIC_TEST_ORIGIN": "https://website-test-zero.pages.dev"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "OUTCOME_DB",
      "database_name": "looking-zero-outcomes",
      "database_id": "cde2e5ea-cbf3-420c-869a-692e79c6525c"
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "PILOT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
